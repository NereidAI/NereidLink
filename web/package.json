{
  "name": "nereidlink-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "check:help": "node scripts/check-help-docs.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "npm run check:help && npm run check:i18n",
    "test:inference": "node --experimental-strip-types scripts/test-inference-binding.mjs",
    "test:shadow": "node --experimental-strip-types scripts/test-shadow-events.mjs",
    "test:business": "node --experimental-strip-types scripts/test-business-resources.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@tanstack/react-query": "^5.104.0",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "antd": "^5.21.0",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "qrcode.react": "4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.4",
    "react-i18next": "^15.7.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.6",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.0"
