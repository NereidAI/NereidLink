# Canonical non-sensitive template; keep this file unchanged. From the Compose
# directory, copy it to ../../../.deployment/deploy-values/nereidlink/compose.env
# and pass that file with --env-file or COMPOSE_ENV_FILES. A local .env remains
# supported for standalone installations without the central directory layout.

# NereidLink image tag, applied to BOTH split images
# (ghcr.io/nereidai/nereidlink-backend and nereidlink-frontend).
# Default in the compose files is the rolling dev channel 0.0.0-dev; set the
# bare SemVer of a tagged release (e.g. 0.0.1) to pin the stack to it.
NL_VERSION=0.0.0-dev

# Email registered with Let's Encrypt for expiry/security notifications.
# Only used by the standalone-edge profile (Mode B); ignored when the host
# nginx terminates TLS (Mode A).
CERTBOT_EMAIL=your-address@example.com

# Set to 1 to issue against the Let's Encrypt staging environment while
# testing (fake but high rate limit). Mode B only. Switch back to 0 and force
# a renewal for a production certificate.
STAGING=0
